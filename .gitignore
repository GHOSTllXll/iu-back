.env
.env.*
!.env.example

# Celery worker watchdog artifacts (ensure_celery_worker.sh)
celery_worker.pid
celery_worker.log
celery_watchdog.log

# Local Redis dump artifact — never commit actual cache/broker data
dump.rdb
